<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>LocalGo</title>
<style>
:root{--bg:#f3f6fb;--ink:#14213a;--muted:#64748b;--navy:#0d1b2e;--blue:#1877ff;--blue2:#0f63e0;--sky:#2a9bff;--line:#dde5f0;--pill:#e8f0fe;--pilltx:#2c5aa0;--gold:#a16a00;--shadow:0 14px 40px rgba(20,40,80,.12);color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:calc(84px + env(safe-area-inset-top,0px))}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif}body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--navy);z-index:30}
button,input,select,textarea{font:inherit}button{cursor:pointer}.wrap{max-width:1180px;margin:auto;padding:0 28px}
header{background:var(--navy);position:sticky;top:env(safe-area-inset-top,0px);z-index:20}.nav{height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{font-weight:900;font-size:26px;color:#fff;text-decoration:none;letter-spacing:-.5px}.brand span{color:var(--sky)}.navlinks{display:flex;gap:22px}.navlinks a{color:#cfe0f5;text-decoration:none;font-size:14px}.navlinks a:hover{color:#fff}
.hero{background:linear-gradient(120deg,#0d1b2e 0%,#14386b 60%,#164a91 100%);color:#fff;padding:64px 0 72px}.hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:44px;align-items:center}
.eyebrow{color:#7fb8ff;font-size:13px;letter-spacing:2.5px;font-weight:700;text-transform:uppercase}.hero h1{font-size:clamp(34px,5vw,58px);line-height:1.08;margin:16px 0;letter-spacing:-1px}.hero p{color:#cfe0f5;line-height:1.7;font-size:17px;max-width:560px;margin:0}
.searchbox{display:flex;gap:8px;background:#fff;padding:7px;border-radius:16px;max-width:600px;margin-top:28px;box-shadow:0 12px 36px rgba(0,0,0,.25)}.searchbox input{border:0;outline:0;flex:1;min-width:0;padding:0 14px;color:var(--ink)}.searchbox button{background:var(--blue);color:#fff;border:0;border-radius:11px;padding:14px 24px;font-weight:700}
.hero-logo{width:100%;display:block;border-radius:24px;border:1px solid rgba(255,255,255,.1);box-shadow:0 20px 60px rgba(0,0,0,.35)}
main{padding:46px 0 70px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:20px}.section-head h2{font-size:32px;margin:0 0 6px}.section-head p{margin:0;color:var(--muted)}
.select{border:1px solid var(--line);background:#fff;padding:13px 14px;border-radius:12px;color:var(--ink)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px}.stat{background:#fff;border:1px solid var(--line);border-radius:18px;padding:14px 18px}.stat b{display:block;font-size:26px;color:var(--blue)}.stat span{font-size:13px;color:var(--muted)}
.filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:24px}.chip{border:1px solid var(--line);background:#fff;border-radius:14px;padding:16px;font-weight:700;font-size:14px;color:var(--ink);text-align:left}.chip.active,.chip:hover{background:#eef5ff;border-color:#2b7cff}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.place{background:#fff;border:1px solid var(--line);border-radius:22px;padding:22px;display:flex;flex-direction:column;transition:.2s}.place:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.place-top{display:flex;justify-content:space-between;align-items:center}.pill{display:inline-block;background:var(--pill);color:var(--pilltx);border-radius:20px;padding:6px 12px;font-size:13px}.rating{color:var(--gold);font-weight:700}
.place h3{font-size:21px;margin:16px 0 8px}.place-desc{color:var(--muted);line-height:1.55;font-size:15px;min-height:46px;margin:0}.place-addr{color:var(--muted);font-size:14px;margin:16px 0}.place-actions{display:flex;gap:10px;margin-top:auto}
.btn{background:var(--blue);color:#fff;border:0;border-radius:12px;padding:13px 18px;font-weight:700}.btn:hover{background:var(--blue2)}.btn-ghost{background:#fff;color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:13px 16px;font-weight:700}.btn-ghost:hover{border-color:#2b7cff}.heart{color:#6d7888}.heart.on{color:#e24d69;border-color:#f3c3cd}
.empty{grid-column:1/-1;background:#fff;border:1px dashed #c3cfe0;border-radius:18px;text-align:center;padding:45px;color:var(--muted)}.note{font-size:13px;color:var(--muted);margin-top:16px}
.about{background:#e8f0ff;border-radius:30px;padding:34px;margin-top:48px;line-height:1.7;font-size:17px}.about p{margin:0 0 12px}.feature-actions{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0}
.panel{background:#fff;border:1px solid var(--line);border-radius:24px;padding:30px;margin-top:32px}.panel h2{font-size:30px;margin:0 0 6px}.panel .sub{color:var(--muted);margin:0 0 18px}
footer{background:var(--navy);color:#9fb3cc;padding:30px 0;font-size:13px}.footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}footer a{color:#7fb8ff;text-decoration:none}
.modal-back{position:fixed;inset:0;background:#08111dcc;z-index:50;display:none;align-items:center;justify-content:center;padding:18px}.modal-back.show{display:flex}.modal{background:#fff;width:min(560px,100%);max-height:90vh;overflow:auto;border-radius:24px;padding:26px;position:relative;box-shadow:0 25px 90px #0005}.modal h2{font-size:26px;margin:12px 36px 8px 0}.modal p{color:var(--muted);line-height:1.6;font-size:15px}.close{position:absolute;right:16px;top:16px;border:0;background:#eef2f8;width:36px;height:36px;border-radius:50%;font-size:20px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 18px}.field{display:flex;flex-direction:column;gap:6px;margin:8px 0}.field.full{grid-column:1/-1}.field label{font-size:14px;font-weight:700;color:#33425b}.field input,.field select,.field textarea{border:1px solid var(--line);border-radius:12px;padding:14px;outline:none;width:100%;background:#fff;color:var(--ink)}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--blue)}.field textarea{min-height:100px;resize:vertical}.submit{width:100%;margin-top:10px}
.qr-wrap{display:grid;place-items:center;background:var(--bg);border-radius:16px;padding:20px;margin:14px 0;min-height:220px}.qr-wrap img,.qr-wrap canvas{max-width:100%}.qr-err{color:#b33;font-size:13px;text-align:center}.notice{font-size:12px;color:var(--muted);margin-top:10px}
.stars{display:flex;gap:4px;margin:6px 0}.stars button{border:0;background:none;font-size:28px;color:#cfd6e0;padding:0}.stars button.on{color:#f5a623}.review{border-top:1px solid var(--line);padding:10px 0;font-size:14px;line-height:1.5}.review small{color:var(--muted)}
.toast{position:fixed;bottom:calc(22px + env(safe-area-inset-bottom,0px));left:50%;transform:translate(-50%,20px);opacity:0;background:var(--navy);color:#fff;padding:13px 18px;border-radius:12px;z-index:80;transition:.25s;box-shadow:var(--shadow);font-size:14px}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr}.hero-logo{max-width:420px}.grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.long,.hide-m{display:none}.navlinks{gap:14px}.navlinks a{font-size:13px}}
@media(max-width:560px){.wrap{padding:0 17px}.hero{padding:44px 0 50px}.hero p{font-size:15px}.searchbox{flex-wrap:wrap}.searchbox input{height:42px;flex-basis:100%}.searchbox button{width:100%}.grid{grid-template-columns:1fr}.section-head{align-items:start;flex-direction:column}.select{width:100%}.section-head h2{font-size:26px}.stat{padding:11px}.stat b{font-size:20px}.filters{grid-template-columns:1fr 1fr}.about,.panel{padding:22px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.footer-inner{flex-direction:column}}
.logo-card{background:#060b17;padding:40px 20px;text-align:center}.lc-pin{font-size:56px;line-height:1}.lc-name{font-size:48px;font-weight:900;color:#fff;letter-spacing:-1px}.lc-name span{color:#2a9bff}.lc-sub{color:#b9c6da;margin-top:8px;font-size:15px}
</style>
</head>
<body>
<header><div class="wrap nav"><a class="brand" href="#top">Local<span>Go</span></a><nav class="navlinks"><a href="#catalog">Каталог</a><a class="hide-m" href="#about">О проекте</a><a href="#add">Добавить<span class="long"> организацию</span></a><a href="#" onclick="openQR();return false">QR-код</a></nav></div></header>
<section class="hero" id="top"><div class="wrap hero-grid"><div><div class="eyebrow">LocalGo · Алматы</div><h1>Всё нужное рядом с тобой</h1><p>Находи кафе, магазины, услуги и образовательные центры. Ищи, сравнивай и выбирай подходящие места в одном каталоге.</p><div class="searchbox"><input id="heroSearch" aria-label="Поиск" placeholder="Например, кофейня или ремонт..." oninput="searchFromHero()"><button onclick="runSearch()">Найти</button></div></div><div class="hero-logo logo-card"><div class="lc-pin">📍</div><div class="lc-name">Local<span>Go</span></div><div class="lc-sub">Всё нужное рядом с тобой</div></div></div></section>
<main class="wrap" id="catalog">
 <div class="section-head"><div><h2>Каталог организаций</h2><p>Выбери категорию или воспользуйся поиском</p></div><select class="select" id="sortSelect" aria-label="Сортировка" onchange="render()"><option value="rating">Сначала высокий рейтинг</option><option value="reviews">Больше отзывов</option><option value="name">По названию</option></select></div>
 <div class="stats"><div class="stat"><b id="stTotal">0</b><span>организаций в каталоге</span></div><div class="stat"><b id="stFav">0</b><span>в избранном</span></div><div class="stat"><b id="stAvg">0</b><span>средний рейтинг</span></div></div>
 <div class="filters" id="filters"><button class="chip active" data-cat="Все" onclick="setCategory('Все',this)">✨ Все</button><button class="chip" data-cat="Кафе" onclick="setCategory('Кафе',this)">☕ Кафе</button><button class="chip" data-cat="Магазины" onclick="setCategory('Магазины',this)">🛍️ Магазины</button><button class="chip" data-cat="Услуги" onclick="setCategory('Услуги',this)">💼 Услуги</button><button class="chip" data-cat="Образование" onclick="setCategory('Образование',this)">🎓 Образование</button><button class="chip" data-cat="Избранное" onclick="setCategory('Избранное',this)">♥ Избранное</button></div>
 <div class="grid" id="placesGrid"></div>
 <div class="note">Организации и рейтинги в начальном каталоге — демонстрационные примеры.</div>
 <section class="about" id="about"><p><b>LocalGo</b> — это веб-сервис для поиска кафе, магазинов, услуг и образовательных организаций. Цель проекта — помочь пользователям быстро находить необходимые места и получать основную информацию о них.</p><p><b>Как это работает:</b> выбери категорию → найди организацию → открой подробности → свяжись с ней по указанным контактам.</p><div class="feature-actions"><button class="btn" onclick="openQR()">Создать QR-код</button><button class="btn-ghost" onclick="openAdd()">Добавить организацию</button></div></section>
 <section class="panel" id="add"><h2>Добавить организацию</h2><p class="sub">Заполни форму — карточка появится в каталоге на этом устройстве.</p>
 <form id="addForm"><div class="form-grid">
  <div class="field"><label>Название *</label><input name="name" required maxlength="50" placeholder="Например, Coffee Point"></div>
  <div class="field"><label>Категория *</label><select name="category" required><option>Кафе</option><option>Магазины</option><option>Услуги</option><option>Образование</option></select></div>
  <div class="field"><label>Адрес *</label><input name="address" required placeholder="Город, улица"></div>
  <div class="field"><label>Телефон или контакт</label><input name="contact" maxlength="60" placeholder="+7 ... или Instagram"></div>
  <div class="field"><label>Рейтинг (1–5)</label><input name="rating" type="number" min="1" max="5" step=".1" value="5"></div><div></div>
  <div class="field full"><label>Описание *</label><textarea name="desc" required maxlength="160" placeholder="Расскажи об организации"></textarea></div>
 </div><button class="btn" type="submit">Добавить в каталог</button></form>
 <div class="note">Важно: новые записи сохраняются в памяти браузера на этом устройстве. Они не отправляются на сервер и не видны другим посетителям.</div></section>
</main>
<footer><div class="wrap footer-inner"><div><b style="color:#fff;font-size:18px">Local<span style="color:#2a9bff">Go</span></b><div style="margin-top:6px">Всё нужное рядом с тобой.</div></div><div>Учебный MVP-проект · 2026</div><div><a href="https://sites.google.com/turan-edu.kz/localgo/%D0%B3%D0%BB%D0%B0%D0%B2%D0%BD%D0%B0%D1%8F-%D1%81%D1%82%D1%80%D0%B0%D0%BD%D0%B8%D1%86%D0%B0" target="_blank" rel="noopener">Исходный сайт на Google Sites ↗</a></div></div></footer>
<div class="modal-back" id="detailModal" onclick="backdropClose(event,'detailModal')"><div class="modal"><button class="close" aria-label="Закрыть" onclick="closeModal('detailModal')">×</button><div id="detailContent"></div></div></div>
<div class="modal-back" id="qrModal" onclick="backdropClose(event,'qrModal')"><div class="modal"><button class="close" aria-label="Закрыть" onclick="closeModal('qrModal')">×</button><h2>QR-код организации</h2><p>Выбери организацию или введи ссылку/текст. QR-код можно скачать в PNG.</p>
<div class="field"><label>Что закодировать</label><select id="qrPlace" onchange="fillQRFromPlace()"><option value="">Выбрать организацию из каталога</option></select></div>
<div class="field"><label>Ссылка или текст</label><input id="qrText" placeholder="https://example.com или название"></div>
<div class="field"><label>Размер QR-кода</label><select id="qrSize"><option value="160">Маленький</option><option value="200" selected>Средний</option><option value="260">Большой</option></select></div>
<button class="btn submit" id="genBtn" onclick="generateQR()">Сгенерировать QR-код</button>
<div class="qr-wrap" id="qrOutput"><span style="color:#8a96a8;font-size:13px">Здесь появится твой QR-код</span></div>
<button class="btn-ghost submit" id="downloadQR" style="display:none" onclick="downloadQR()">Скачать QR-код PNG</button><div class="notice">Для генерации QR-кода нужен интернет при первой загрузке библиотеки.</div></div></div>
<div class="toast" id="toast"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
const starterPlaces=[
{id:1,name:"Coffee Point",category:"Кафе",address:"Алматы · демонстрационный адрес",rating:4.9,desc:"Уютная кофейня для встреч, завтраков и кофе с собой."},
{id:2,name:"Study Hub",category:"Образование",address:"Алматы · демонстрационный адрес",rating:4.9,desc:"Демонстрационный учебный центр с курсами и занятиями."},
{id:3,name:"Tech Repair",category:"Услуги",address:"Алматы · демонстрационный адрес",rating:4.8,desc:"Пример сервиса по ремонту и обслуживанию техники."},
{id:4,name:"Green Bowl",category:"Кафе",address:"Алматы · демонстрационный адрес",rating:4.7,desc:"Пример кафе с лёгкими блюдами и напитками."},
{id:5,name:"City Market",category:"Магазины",address:"Алматы · демонстрационный адрес",rating:4.6,desc:"Демонстрационная карточка магазина товаров на каждый день."},
{id:6,name:"Book Corner",category:"Магазины",address:"Алматы · демонстрационный адрес",rating:4.5,desc:"Пример книжного магазина и пространства для чтения."}
];
function ls(k,d){try{return JSON.parse(localStorage.getItem(k)||"null")||d}catch(e){return d}}
let places=ls("localgo2_places",starterPlaces);
let favorites=ls("localgo2_favs",[]);let reviews=ls("localgo2_reviews",{});
let category="Все",query="";
function save(){try{localStorage.setItem("localgo2_places",JSON.stringify(places));localStorage.setItem("localgo2_favs",JSON.stringify(favorites));localStorage.setItem("localgo2_reviews",JSON.stringify(reviews))}catch(e){}}
function ratingOf(p){const r=reviews[p.id]||[];return(Number(p.rating)*3+r.reduce((a,x)=>a+x.s,0))/(3+r.length)}
function updateStats(){document.getElementById("stTotal").textContent=places.length;document.getElementById("stFav").textContent=favorites.length;document.getElementById("stAvg").textContent=places.length?(places.reduce((a,p)=>a+ratingOf(p),0)/places.length).toFixed(1):"—"}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function render(){
updateStats();let list=places.filter(p=>(category==="Все"||p.category===category||(category==="Избранное"&&favorites.includes(p.id)))&&(!query||(p.name+" "+p.category+" "+p.address+" "+p.desc).toLowerCase().includes(query.toLowerCase())));
const sort=document.getElementById("sortSelect").value;if(sort==="rating")list.sort((a,b)=>ratingOf(b)-ratingOf(a));if(sort==="reviews")list.sort((a,b)=>(reviews[b.id]||[]).length-(reviews[a.id]||[]).length);if(sort==="name")list.sort((a,b)=>a.name.localeCompare(b.name,"ru"));
const grid=document.getElementById("placesGrid");
if(!list.length){grid.innerHTML='<div class="empty">Ничего не найдено. Попробуй изменить запрос или категорию.</div>';return}
grid.innerHTML=list.map(p=>`<article class="place"><div class="place-top"><span class="pill">${esc(p.category)}</span><span class="rating">★ ${ratingOf(p).toFixed(1)}</span></div><h3>${esc(p.name)}</h3><p class="place-desc">${esc(p.desc)}</p><div class="place-addr">📍 ${esc(p.address)}</div><div class="place-actions"><button class="btn" onclick="showDetails(${p.id})">Подробнее</button><button class="btn-ghost heart ${favorites.includes(p.id)?"on":""}" aria-label="В избранное" onclick="toggleFav(${p.id})">${favorites.includes(p.id)?"♥":"♡"}</button></div></article>`).join("");
}
function setCategory(c,el){category=c;document.querySelectorAll(".chip").forEach(b=>b.classList.toggle("active",b.dataset.cat===c));render()}
function searchFromHero(){query=document.getElementById("heroSearch").value;render()}
function runSearch(){searchFromHero();document.getElementById("catalog").scrollIntoView({behavior:"smooth"})}
function toggleFav(id){favorites=favorites.includes(id)?favorites.filter(x=>x!==id):[...favorites,id];save();render();toast(favorites.includes(id)?"Добавлено в избранное":"Удалено из избранного")}
let draftStars=5;
function showDetails(id){const p=places.find(x=>x.id===id);if(!p)return;draftStars=5;const rs=reviews[id]||[];document.getElementById("detailContent").innerHTML=`<span class="pill">${esc(p.category)}</span><h2>${esc(p.name)}</h2><div class="rating">★ ${ratingOf(p).toFixed(1)} · отзывов: ${rs.length}</div><p>${esc(p.desc)}</p><p><b>Адрес:</b> ${esc(p.address)}</p>${p.contact?`<p><b>Контакт:</b> ${esc(p.contact)}</p>`:""}<div class="feature-actions"><button class="btn" onclick="openQRFor(${p.id})">QR-код организации</button><button class="btn-ghost" onclick="toggleFav(${p.id});showDetails(${p.id})">${favorites.includes(p.id)?"Убрать из избранного":"В избранное"}</button>${p.custom?`<button class="btn-ghost" onclick="deletePlace(${p.id})">Удалить организацию</button>`:""}</div><h3 style="font-size:17px;margin:22px 0 2px">Оставить отзыв</h3><div class="stars" id="stars">${[1,2,3,4,5].map(n=>`<button type="button" class="on" aria-label="Оценка ${n}" onclick="setStars(${n})">★</button>`).join("")}</div><div class="field"><textarea id="revText" maxlength="140" placeholder="Что понравилось? (минимум 5 символов)"></textarea></div><button class="btn submit" onclick="addReview(${p.id})">Отправить отзыв</button><div>${rs.map(r=>`<div class="review"><b style="color:#f0a020">${"★".repeat(r.s)}</b> ${esc(r.t)}<br><small>${esc(r.d)}</small></div>`).join("")}</div>`;openModal("detailModal")}
function setStars(n){draftStars=n;document.querySelectorAll("#stars button").forEach((b,i)=>b.classList.toggle("on",i<n))}
function addReview(id){const t=document.getElementById("revText").value.trim();if(t.length<5){toast("Отзыв слишком короткий — минимум 5 символов");return}reviews[id]=[{s:draftStars,t:t,d:new Date().toLocaleDateString("ru-RU")},...(reviews[id]||[])];save();render();showDetails(id);toast("Спасибо за отзыв!")}
function deletePlace(id){places=places.filter(p=>p.id!==id);favorites=favorites.filter(x=>x!==id);delete reviews[id];save();closeModal("detailModal");render();toast("Организация удалена")}
function openAdd(){const el=document.getElementById("add");el.scrollIntoView({behavior:"smooth"});setTimeout(()=>el.querySelector("input").focus({preventScroll:true}),450)}
document.getElementById("addForm").addEventListener("submit",e=>{e.preventDefault();const f=new FormData(e.target);const p={id:Date.now(),name:f.get("name").trim(),category:f.get("category"),address:f.get("address").trim(),rating:Math.min(5,Math.max(1,Number(f.get("rating"))||5)),desc:f.get("desc").trim(),contact:(f.get("contact")||"").trim(),custom:true};if(!p.name||!p.address||!p.desc){toast("Заполни обязательные поля");return}if(places.some(x=>x.name.toLowerCase()===p.name.toLowerCase())){toast("Такая организация уже есть в каталоге");return}places.unshift(p);save();e.target.reset();document.getElementById("catalog").scrollIntoView({behavior:"smooth"});category="Все";document.querySelectorAll(".chip").forEach(b=>b.classList.toggle("active",b.dataset.cat==="Все"));query="";document.getElementById("heroSearch").value="";render();toast("Организация добавлена в каталог")});
function openQR(){const sel=document.getElementById("qrPlace");sel.innerHTML='<option value="">Выбрать организацию из каталога</option>'+places.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join("");document.getElementById("qrText").value="";document.getElementById("qrOutput").innerHTML='<span style="color:#8a96a8;font-size:13px">Здесь появится твой QR-код</span>';document.getElementById("downloadQR").style.display="none";document.getElementById("genBtn").textContent="Сгенерировать QR-код";openModal("qrModal")}
function openQRFor(id){closeModal("detailModal");openQR();document.getElementById("qrPlace").value=String(id);fillQRFromPlace()}
function fillQRFromPlace(){const p=places.find(x=>x.id===Number(document.getElementById("qrPlace").value));if(p)document.getElementById("qrText").value=`LocalGo: ${p.name} | ${p.category} | ${p.address}`}
function generateQR(){const value=document.getElementById("qrText").value.trim();if(!value){toast("Введи текст или выбери организацию");return}const out=document.getElementById("qrOutput");out.innerHTML="";if(typeof QRCode==="undefined"){out.innerHTML='<span class="qr-err">Не удалось загрузить генератор. Проверь интернет и обнови страницу.</span>';return}const sz=Number(document.getElementById("qrSize").value)||200;try{new QRCode(out,{text:value,width:sz,height:sz,colorDark:"#0d1b2e",colorLight:"#ffffff",correctLevel:QRCode.CorrectLevel.M})}catch(e){out.innerHTML='<span class="qr-err">Текст слишком длинный для QR-кода. Сократи его (до ~100 символов).</span>';document.getElementById("downloadQR").style.display="none";toast("Ошибка: слишком длинный текст");return}document.getElementById("downloadQR").style.display="block";document.getElementById("genBtn").textContent="↻ Сгенерировать заново";toast("QR-код создан")}
async function downloadQR(){const c=document.querySelector("#qrOutput canvas");if(!c){toast("Сначала создай QR-код");return}const pad=24,o=document.createElement("canvas");o.width=c.width+pad*2;o.height=c.height+pad*2;const x=o.getContext("2d");x.fillStyle="#fff";x.fillRect(0,0,o.width,o.height);x.drawImage(c,pad,pad);const blob=await new Promise(r=>o.toBlob(r,"image/png"));let dl=null;try{dl=window.claude&&await claude.use("downloads")}catch(e){}if(dl){try{await dl.save({filename:"localgo-qr.png",data:blob});toast("QR-код сохранён")}catch(e){if(e&&e.code==="declined")toast("Скачивание отменено");else toast("Не удалось сохранить файл")}return}const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="localgo-qr.png";document.body.appendChild(a);a.click();a.remove();toast("QR-код скачан")}
function openModal(id){document.getElementById(id).classList.add("show")}function closeModal(id){document.getElementById(id).classList.remove("show")}function backdropClose(e,id){if(e.target.id===id)closeModal(id)}
document.addEventListener("keydown",e=>{if(e.key==="Escape")document.querySelectorAll(".modal-back.show").forEach(x=>x.classList.remove("show"))});
let toastTimer;function toast(msg){const el=document.getElementById("toast");el.textContent=msg;el.classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove("show"),2300)}
render();
</script>
</body>
